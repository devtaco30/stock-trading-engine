--- a/loadtest/s0b/lib.sh	1970-01-01 09:00:00
+++ b/loadtest/s0b/lib.sh	2026-11-04 19:05:46
@@ -0,0 +1,166 @@
+#!/usr/bin/env bash
+# s0b 하네스(run.sh·mix.sh·ladder.sh)의 공통 블록. 각 스크립트가 저장소 루트로 cd 한 뒤 `source loadtest/s0b/lib.sh` 한다.
+#   - 시험 전용 Kafka 컨테이너·작업 폴더·jar·yml 준비
+#   - 매칭 shard N개(MATCHING_COUNT=1·2·4·8) 기동과 배정 완료 대기
+#   - 종목 고르기: N=1이면 기존 codes-many, N>1(또는 BALANCED_STOCKS=1)이면 shard마다 같은 수(loadtest/s0b_multi/stock_select.py)
+# 기본(MATCHING_COUNT 없음 = 1)은 기존 명령과 같은 인자로 JVM 하나를 띄운다.
+#
+# 환경 변수 (이 파일에서 새로 정한 이름)
+#   MATCHING_COUNT=1             매칭 shard 수. 1·2·4·8
+#   MATCHING_ASSIGN_TIMEOUT      배정 완료 대기 제한 시간(초). MATCHING_COUNT>1이면 필수(값은 정해지지 않았다)
+#   BALANCED_STOCKS=1            N=1에서도 균등 선택기를 쓴다(N별 비교에서 종목 선택 규칙을 같게 하려는 용도)
+#   S0B_WORK=/tmp/s0b            작업 폴더(시험용으로 바꾼다)
+#   S0B_SELECT_TOOL              종목 선택기 경로(기본 loadtest/s0b_multi/stock_select.py)
+#   S0B_SLEEP_AFTER_START=8      매칭 기동 확인 뒤 쉬는 시간(초, 기존 값)
+#   S0B_POLL_SEC=2, S0B_KILL_WAIT=3  기동 확인 간격, 종료 신호 뒤 기다리는 시간(기존 값)
+source loadtest/matching-plan.sh
+
+S0B_SELECT_TOOL="${S0B_SELECT_TOOL:-loadtest/s0b_multi/stock_select.py}"
+
+# 매칭 shard 수 검증과 matching-plan.sh 변수 맞추기. MATCHING_COUNT>1이면 MATCHING_ASSIGN_TIMEOUT이 필요하다.
+s0b_matching_init() {
+    MATCHING_COUNT="${MATCHING_COUNT:-1}"
+    matching_count_valid "$MATCHING_COUNT" || return 1
+    MATCHING_POOL_COUNT="$MATCHING_COUNT"
+    # 자체 Kafka(s0b-kafka)를 matching-plan.sh 의 배정 확인 대상으로 쓴다.
+    MATCHING_KAFKA_CONTAINER="s0b-kafka"
+    MATCHING_KAFKA_BOOTSTRAP="localhost:19092"
+    # 매칭 Archive 제어 포트는 8100+i. 계좌 워커 둘(mix.sh ACCOUNT_WORKERS=2)이 8100·8101을 쓰므로 그때는 8200+i.
+    MATCHING_CONTROL_BASE_PORT=8100
+    [ "${ACCOUNT_WORKERS:-1}" = 2 ] && MATCHING_CONTROL_BASE_PORT=8200
+    if [ "$MATCHING_COUNT" != "1" ] && [ -z "${MATCHING_ASSIGN_TIMEOUT:-}" ]; then
+        echo "MATCHING_COUNT=${MATCHING_COUNT}에는 MATCHING_ASSIGN_TIMEOUT(배정 완료 대기 제한 시간, 초)이 필요하다 — 값은 정해지지 않았다" >&2
+        return 1
+    fi
+    return 0
+}
+
+# 시작 전에 비어 있어야 하는 UDP 포트(공백 구분). $1=계좌 워커 수(1·2). MATCHING_COUNT=1이면 기존 스크립트의 목록과 같다.
+s0b_udp_ports() {
+    local aw="${1:-1}" i out=""
+    for i in $(seq 0 $((MATCHING_COUNT - 1))); do out="$out $(matching_intake_port "$i")"; done
+    if [ "$aw" = 2 ]; then out="$out 20040 20041 20060 20061"; else out="$out 20040 20060 8010"; fi
+    if [ "$MATCHING_COUNT" = 1 ]; then
+        if [ "$aw" = 2 ]; then out="$out 8011 8100 8101"; else out="$out 8011 8012"; fi
+    else
+        [ "$aw" = 2 ] && out="$out 8100 8101"
+        for i in $(seq 0 $((MATCHING_COUNT - 1))); do out="$out $(matching_control_port "$i")"; done
+    fi
+    echo "${out# }"
+}
+
+s0b_check_ports() {
+    local p
+    for p in $(s0b_udp_ports "${ACCOUNT_WORKERS:-1}"); do
+        lsof -nP -iUDP:"$p" > /dev/null 2>&1 && { echo "PORT_BUSY UDP $p"; return 5; }
+    done
+    lsof -nP -iTCP:19092 -sTCP:LISTEN > /dev/null 2>&1 && { echo "PORT_BUSY TCP 19092"; return 5; }
+    return 0
+}
+
+s0b_setup_workdir() {
+    W="${S0B_WORK:-/tmp/s0b}"; LOG="$W/logs"
+    rm -rf "$W"; mkdir -p "$LOG"; : > "$W/pids"
+    JO=(--add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED)
+    KB=--spring.kafka.bootstrap-servers=localhost:19092
+    MATCHING_ARCHIVE_ROOT="$W"   # matching_args 가 shard별 폴더 $W/matching-<i> 를 만든다
+}
+
+s0b_start_kafka() {
+    docker rm -f s0b-kafka > /dev/null 2>&1
+    docker run -d --name s0b-kafka -p 19092:19092 \
+     -e KAFKA_NODE_ID=1 -e KAFKA_PROCESS_ROLES=broker,controller -e KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:19093 \
+     -e KAFKA_LISTENERS=PLAINTEXT://:19092,CONTROLLER://:19093 -e KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:19092 \
+     -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
+     -e KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \
+     -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 \
+     -e KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0 apache/kafka@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837 > /dev/null
+    for _ in $(seq 1 60); do docker exec s0b-kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:19092 --list > /dev/null 2>&1 && break; sleep 1; done
+}
+
+# 빌드(SKIP_BUILD=1이면 생략), jar 고르기(MATCHING_JAR·ACCOUNT_JAR로 지정 가능), 작업 폴더용 yml 만들기.
+s0b_prepare_jars_and_yml() {
+    if [ "${SKIP_BUILD:-0}" != 1 ]; then
+        ./gradlew --offline -q :matching-worker:bootJar :account-worker:bootJar > "$LOG/build.log" 2>&1 || { echo BUILD_FAIL; tail -20 "$LOG/build.log"; return 1; }
+    fi
+    MJ=${MATCHING_JAR:-$(ls matching-worker/build/libs/*.jar | grep -v plain | head -1)}
+    AJ=${ACCOUNT_JAR:-$(ls account-worker/build/libs/*.jar | grep -v plain | head -1)}
+    sed "s#/tmp/u10#$W#" loadtest/u10/u10-matching-0.yml > "$W/m0.yml"
+    sed "s#/tmp/u10#$W#" loadtest/u10/u10-account.yml > "$W/acc.yml"
+}
+
+# shard i 의 추가 기동 인자(신원·입구·제어·폴더·이동 주소 풀). MATCHING_COUNT=1이면 빈 문자열이라 yml 값 그대로다.
+s0b_matching_extra_args() {
+    matching_args "$MATCHING_COUNT" "$1" "$MATCHING_POOL_COUNT"
+}
+
+# 계좌 워커에 줄 매칭 주소 풀 인자. MATCHING_COUNT=1이면 빈 문자열(yml 값 그대로).
+s0b_account_pool_args() {
+    matching_account_args "$MATCHING_POOL_COUNT"
+}
+
+# 매칭 JVM N개 기동. 인자는 JVM마다 붙는 추가 인자(mix.sh의 MATCH_EXTRA). 결과: MP_LIST(pid 배열), MP(첫 pid).
+# 모두 "Started MatchingWorkerApplication"이 찍힐 때까지 기다리고, N>1이면 종목 slot 64개가 N개 주소로 배정될 때까지 기다린다.
+s0b_matching_start_label() { if [ "$MATCHING_COUNT" = 1 ]; then echo matching; else echo "matching-$1"; fi; }
+s0b_start_matching() {
+    local i extra_array gc_name
+    MP_LIST=()
+    for i in $(seq 0 $((MATCHING_COUNT - 1))); do
+        read -ra extra_array <<< "$(s0b_matching_extra_args "$i")"
+        gc_name="gc-matching.log"; [ "$i" -gt 0 ] && gc_name="gc-matching-$i.log"
+        java "${JO[@]}" -Xlog:gc*:file="$LOG/$gc_name":time,uptime -jar "$MJ" --spring.config.additional-location=file:"$W/m0.yml" $KB \
+            ${@+"$@"} ${extra_array[@]+"${extra_array[@]}"} > "$LOG/matching-$i.log" 2>&1 &
+        MP_LIST+=($!); echo $! >> "$W/pids"
+    done
+    MP="${MP_LIST[0]}"
+    for i in $(seq 0 $((MATCHING_COUNT - 1))); do
+        for _ in $(seq 1 60); do grep -q "Started MatchingWorkerApplication" "$LOG/matching-$i.log" && break; sleep "${S0B_POLL_SEC:-2}"; done
+        grep -q "Started MatchingWorkerApplication" "$LOG/matching-$i.log" || { echo "START_FAIL $(s0b_matching_start_label "$i")"; return 6; }
+    done
+    if [ "$MATCHING_COUNT" != "1" ]; then
+        await_matching_slots_assigned "${MATCHING_STOCK_SLOT_COUNT:-64}" "$MATCHING_ASSIGN_TIMEOUT" "$MATCHING_COUNT" || { echo "START_FAIL matching 배정 완료 대기"; return 6; }
+    fi
+    sleep "${S0B_SLEEP_AFTER_START:-8}"
+}
+
+# cpu_sample.sh 에 줄 역할=pid 목록(매칭 부분). 1개면 기존 이름 matching, 여러 개면 matching-0=pid ...
+s0b_matching_roles() {
+    local i out=""
+    if [ "${#MP_LIST[@]}" = 1 ]; then echo "matching=${MP_LIST[0]}"; return 0; fi
+    for i in $(seq 0 $((${#MP_LIST[@]} - 1))); do out="$out matching-$i=${MP_LIST[$i]}"; done
+    echo "${out# }"
+}
+
+# 외부 호출은 함수로 감싸 시험에서 바꾼다.
+s0b_assigned_map() { matching_assigned_map; }
+s0b_u10() { ./gradlew --offline -q :account-worker:u10Tool -Pu10Args="$*" 2>&1; }
+
+# 종목 고르기. $1=종목 수, $2=N=1 기존 방식의 splitSlot(종목 수 3이면 32, 그 밖은 0). 결과: STOCKS(공백 구분), SELECT_OUT(선택기 출력, 기존 방식이면 빈 값).
+s0b_pick_stocks() {
+    local count="$1" split="$2"
+    if [ "$MATCHING_COUNT" != 1 ] || [ "${BALANCED_STOCKS:-0}" = 1 ]; then
+        SELECT_OUT="$(s0b_assigned_map | python3 -I "$S0B_SELECT_TOOL" --count "$count" --slot-count "${MATCHING_STOCK_SLOT_COUNT:-64}")" || { echo "종목 균등 선택 실패" >&2; return 1; }
+        STOCKS="$(printf '%s\n' "$SELECT_OUT" | sed -n 's/^STOCKS=//p')"
+    else
+        SELECT_OUT=""
+        STOCKS=$(s0b_u10 "codes-many 64 $split $count" | grep '^HIGH=' | tail -1 | sed 's/^HIGH=//' | tr ',' ' ')
+    fi
+}
+
+# 균등 선택이면 종목별 slot·shard를 $1/slots.txt 에, shard별 종목 수를 $1/shard-stocks.txt 에 남긴다. 기존 방식은 $2=always 일 때만 slot-of 로 slots.txt 를 만든다(mix.sh).
+s0b_write_stock_report() {
+    if [ -n "$SELECT_OUT" ]; then
+        printf '%s\n' "$SELECT_OUT" | grep '^SLOT ' > "$1/slots.txt"
+        printf '%s\n' "$SELECT_OUT" | grep '^SHARD_STOCKS ' > "$1/shard-stocks.txt"
+    elif [ "${2:-}" = always ]; then
+        s0b_u10 "slot-of 64 $STOCKS" | grep '^SLOT' > "$1/slots.txt"
+    fi
+}
+
+# 종료 신호 → 대기 → 강제 종료 → 시험 Kafka 제거. 스크립트의 cleanup 에서 부른다.
+s0b_kill_pids() {
+    while read -r p; do kill "$p" 2>/dev/null; done < "$W/pids"
+    sleep "${S0B_KILL_WAIT:-3}"
+    while read -r p; do kill -9 "$p" 2>/dev/null; done < "$W/pids"
+    docker rm -f s0b-kafka > /dev/null 2>&1
+}
--- a/loadtest/s0b/test_lib.sh	1970-01-01 09:00:00
+++ b/loadtest/s0b/test_lib.sh	2026-11-04 19:06:09
@@ -0,0 +1,143 @@
+#!/usr/bin/env bash
+# lib.sh(s0b 공통 블록 + 매칭 N개 기동·종목 균등 선택)의 시험. 실제 docker·java·gradle 없이 가짜 명령으로 돈다.
+# 실행: bash loadtest/s0b/test_lib.sh (저장소 루트에서)
+cd "$(dirname "$0")/../.."
+ROOT="$(pwd)"
+PASS=0; FAIL=0
+check() { # 이름, 기대 문자열(그대로 포함), 실제
+  if printf '%s' "$3" | grep -qF -- "$2"; then PASS=$((PASS+1)); else FAIL=$((FAIL+1)); echo "FAIL $1: [$2] 가 없다 (실제: $3)"; fi
+}
+check_not() {
+  if printf '%s' "$3" | grep -qF -- "$2"; then FAIL=$((FAIL+1)); echo "FAIL $1: [$2] 가 있으면 안 된다 (실제: $3)"; else PASS=$((PASS+1)); fi
+}
+equals() { # 이름, 기대, 실제
+  if [ "$2" = "$3" ]; then PASS=$((PASS+1)); else FAIL=$((FAIL+1)); echo "FAIL $1: 기대 [$2] 실제 [$3]"; fi
+}
+
+source loadtest/s0b/lib.sh
+
+# --- 포트 목록 ---
+MATCHING_COUNT=1; equals "N=1 계좌 1: 기존 포트 목록 그대로" "20020 20040 20060 8010 8011 8012" "$(s0b_udp_ports 1)"
+MATCHING_COUNT=1; equals "N=1 계좌 2: 기존 포트 목록 그대로" "20020 20040 20041 20060 20061 8011 8100 8101" "$(s0b_udp_ports 2)"
+MATCHING_COUNT=4; equals "N=4 계좌 1" "20020 20021 20022 20023 20040 20060 8010 8100 8101 8102 8103" "$(s0b_udp_ports 1)"
+MATCHING_COUNT=2; ACCOUNT_WORKERS=2; MATCHING_ASSIGN_TIMEOUT=60; s0b_matching_init >/dev/null 2>&1
+equals "N=2 계좌 2: 매칭 제어는 8200 대역" "20020 20021 20040 20041 20060 20061 8100 8101 8200 8201" "$(s0b_udp_ports 2)"
+unset ACCOUNT_WORKERS MATCHING_ASSIGN_TIMEOUT
+
+# --- 초기화 검증 ---
+OUT=$(MATCHING_COUNT=3 bash -c 'cd "'"$ROOT"'"; source loadtest/s0b/lib.sh; s0b_matching_init' 2>&1); RC=$?
+check "N=3 거부" "rc=1" "rc=$RC"; check "N=3 메시지" "1·2·4·8" "$OUT"
+OUT=$(MATCHING_COUNT=2 bash -c 'cd "'"$ROOT"'"; source loadtest/s0b/lib.sh; s0b_matching_init' 2>&1); RC=$?
+check "N=2 배정 제한 시간 없으면 거부" "rc=1" "rc=$RC"; check "N=2 메시지" "MATCHING_ASSIGN_TIMEOUT" "$OUT"
+OUT=$(MATCHING_COUNT=1 bash -c 'cd "'"$ROOT"'"; source loadtest/s0b/lib.sh; s0b_matching_init' 2>&1); RC=$?
+check "N=1은 제한 시간 없이 통과" "rc=0" "rc=$RC"
+OUT=$(MATCHING_COUNT=2 MATCHING_ASSIGN_TIMEOUT=60 bash -c 'cd "'"$ROOT"'"; source loadtest/s0b/lib.sh; s0b_matching_init; echo "$MATCHING_KAFKA_CONTAINER $MATCHING_KAFKA_BOOTSTRAP $MATCHING_CONTROL_BASE_PORT $MATCHING_POOL_COUNT"' 2>&1)
+equals "자체 Kafka 컨테이너·주소·제어 대역" "s0b-kafka localhost:19092 8100 2" "$OUT"
+OUT=$(MATCHING_COUNT=2 MATCHING_ASSIGN_TIMEOUT=60 ACCOUNT_WORKERS=2 bash -c 'cd "'"$ROOT"'"; source loadtest/s0b/lib.sh; s0b_matching_init; echo "$MATCHING_CONTROL_BASE_PORT"' 2>&1)
+equals "계좌 워커 2개면 제어 대역 8200" "8200" "$OUT"
+
+# --- 역할 이름 ---
+MATCHING_COUNT=1; MP_LIST=(11); equals "N=1 역할 이름은 기존 matching" "matching=11" "$(s0b_matching_roles)"
+MATCHING_COUNT=2; MP_LIST=(11 22); equals "N=2 역할 이름" "matching-0=11 matching-1=22" "$(s0b_matching_roles)"
+
+# --- 매칭 JVM 추가 인자 / 계좌 쪽 주소 풀 ---
+W=/tmp/s0b-test
+MATCHING_COUNT=1; MATCHING_POOL_COUNT=1; equals "N=1 추가 인자 없음" "" "$(s0b_matching_extra_args 0)"
+equals "N=1 계좌 풀 인자 없음" "" "$(s0b_account_pool_args)"
+MATCHING_COUNT=2; MATCHING_POOL_COUNT=2; MATCHING_ARCHIVE_ROOT=$W; MATCHING_CONTROL_BASE_PORT=8100; MATCHING_KAFKA_BOOTSTRAP=localhost:19092
+A1="$(s0b_matching_extra_args 1)"
+check "N=2 shard1 신원" "--matching-worker.instance-id=matching-1" "$A1"
+check "N=2 shard1 입구" "--transport.matching-intake.channel=aeron:udp?endpoint=localhost:20021" "$A1"
+check "N=2 shard1 제어" "aeron:udp?endpoint=localhost:8101" "$A1"
+check "N=2 shard1 폴더" "--matching.worker.archive-dir=/tmp/s0b-test/matching-1" "$A1"
+check "N=2 이동 주소 풀" "--matching-shard.handover.endpoints[1]=aeron:udp?endpoint=localhost:20021" "$A1"
+P="$(s0b_account_pool_args)"
+check "N=2 계좌 풀 0" "--matching-shard-routing.endpoints[0]=aeron:udp?endpoint=localhost:20020" "$P"
+check "N=2 계좌 풀 1" "--matching-shard-routing.endpoints[1]=aeron:udp?endpoint=localhost:20021" "$P"
+check "N=2 계좌 쪽 Kafka" "--spring.kafka.bootstrap-servers=localhost:19092" "$P"
+
+# --- 종목 선택 (가짜 배정 표·가짜 u10Tool) ---
+s0b_assigned_map() { for s in $(seq 0 63); do printf '%s\tlocalhost:%s\n' "$s" $((20020 + s % FAKE_N)); done; }
+U10LOG=$(mktemp); s0b_u10() { echo "$*" >> "$U10LOG"; echo "HIGH=000101,000102,000103"; }
+FAKE_N=1; MATCHING_COUNT=1; unset BALANCED_STOCKS
+s0b_pick_stocks 3 32 >/dev/null; equals "N=1 기본은 기존 codes-many" "000101 000102 000103" "$STOCKS"
+check "N=1 codes-many 인자" "codes-many 64 32 3" "$(cat "$U10LOG")"
+FAKE_N=4; MATCHING_COUNT=4; s0b_pick_stocks 30 0 >/dev/null; RC=$?
+equals "N=4 균등 선택 성공" "0" "$RC"
+equals "N=4 종목 30개" "30" "$(echo $STOCKS | wc -w | tr -d ' ')"
+check "N=4 shard 몫" "SHARD_STOCKS localhost:20020=8" "$SELECT_OUT"
+check "N=4 shard 몫 끝" "SHARD_STOCKS localhost:20023=7" "$SELECT_OUT"
+FAKE_N=1; MATCHING_COUNT=1; BALANCED_STOCKS=1; s0b_pick_stocks 30 0 >/dev/null
+equals "N=1도 BALANCED_STOCKS=1이면 균등 선택기" "30" "$(echo $STOCKS | wc -w | tr -d ' ')"
+check "선택기 결과에 slot 줄" "SLOT " "$SELECT_OUT"
+RPT=$(mktemp -d)
+FAKE_N=4; MATCHING_COUNT=4; s0b_pick_stocks 30 0 >/dev/null; s0b_write_stock_report "$RPT"
+equals "균등 선택이면 slots.txt 30줄" "30" "$(wc -l < "$RPT/slots.txt" | tr -d ' ')"
+check "shard-stocks.txt" "SHARD_STOCKS localhost:20021=8" "$(cat "$RPT/shard-stocks.txt")"
+unset BALANCED_STOCKS; FAKE_N=1; MATCHING_COUNT=1; RPT2=$(mktemp -d); : > "$U10LOG"; s0b_pick_stocks 3 32 >/dev/null; s0b_write_stock_report "$RPT2"
+equals "기존 방식은 always 없으면 slots.txt를 만들지 않는다" "no" "$([ -e "$RPT2/slots.txt" ] && echo yes || echo no)"
+equals "기존 방식은 always 없으면 slot-of를 부르지 않는다" "0" "$(grep -c slot-of "$U10LOG")"
+s0b_write_stock_report "$RPT2" always
+check "always면 slot-of로 만든다" "slot-of 64 000101 000102 000103" "$(cat "$U10LOG")"
+rm -rf "$RPT" "$RPT2"
+unset BALANCED_STOCKS
+s0b_assigned_map() { printf '0\tlocalhost:20020\n'; }
+FAKE_N=2; MATCHING_COUNT=2; s0b_pick_stocks 30 0 >/dev/null 2>&1; RC=$?
+equals "배정이 덜 끝난 표는 실패" "1" "$RC"
+
+# --- 가짜 docker·java·gradlew 로 기동 블록 전체 ---
+FAKE=$(mktemp -d); mkdir -p "$FAKE/bin"
+cat > "$FAKE/bin/docker" <<'DOCKER'
+#!/usr/bin/env bash
+case "$*" in
+  *kafka-console-consumer*) for s in $(seq 0 63); do printf '%s\tlocalhost:%s\n' "$s" $((20020 + s % ${FAKE_N:-1})); done ;;
+  *kafka-topics*) exit 0 ;;
+  *) echo "docker $*" >> "$FAKE_DIR/docker.calls"; echo fakeid ;;
+esac
+DOCKER
+cat > "$FAKE/bin/java" <<'JAVA'
+#!/usr/bin/env bash
+echo "java $*" >> "$FAKE_DIR/java.calls"
+case "$*" in *matching*) echo "Started MatchingWorkerApplication" ;; esac
+exec sleep 30
+JAVA
+cat > "$FAKE/bin/lsof" <<'LSOF'
+#!/usr/bin/env bash
+exit 1
+LSOF
+chmod +x "$FAKE/bin/"*
+export FAKE_DIR="$FAKE"
+run_block() { # N -> 기동 블록(포트 검사·Kafka·워크폴더·jar·yml·매칭 기동)을 가짜 명령으로 실행하고 결과를 출력
+  PATH="$FAKE/bin:$PATH" FAKE_N="$1" MATCHING_COUNT="$1" MATCHING_ASSIGN_TIMEOUT=20 SKIP_BUILD=1 S0B_WORK="$FAKE/work-$1" S0B_SLEEP_AFTER_START=0 S0B_POLL_SEC=0.2 S0B_KILL_WAIT=0 \
+    MATCHING_JAR=/x/m.jar ACCOUNT_JAR=/x/a.jar bash -c '
+      cd "'"$ROOT"'"; source loadtest/s0b/lib.sh
+      s0b_matching_init || exit 1
+      s0b_setup_workdir || exit 1
+      s0b_start_kafka || exit 1
+      s0b_prepare_jars_and_yml || exit 1
+      s0b_start_matching || exit 6
+      echo "MP_LIST=${MP_LIST[*]} count=${#MP_LIST[@]}"
+      s0b_kill_pids' 2>&1
+}
+OUT=$(run_block 2); RC=$?
+equals "N=2 기동 블록 종료 코드" "0" "$RC"
+check "N=2 JVM 2개" "count=2" "$OUT"
+check "N=2 배정 완료 출력" "배정 완료" "$OUT"
+equals "N=2 java 호출 2번" "2" "$(grep -c '^java' "$FAKE/java.calls")"
+check "N=2 shard0 입구" "--transport.matching-intake.channel=aeron:udp?endpoint=localhost:20020" "$(cat "$FAKE/java.calls")"
+check "N=2 shard1 입구" "--transport.matching-intake.channel=aeron:udp?endpoint=localhost:20021" "$(cat "$FAKE/java.calls")"
+check "자체 Kafka 주소를 넘긴다" "--spring.kafka.bootstrap-servers=localhost:19092" "$(cat "$FAKE/java.calls")"
+check "yml 경로 치환" "tmp" "$(cat "$FAKE/work-2/m0.yml" 2>/dev/null)"
+rm -f "$FAKE/java.calls"
+OUT=$(run_block 1); RC=$?
+equals "N=1 기동 블록 종료 코드" "0" "$RC"
+check "N=1 JVM 1개" "count=1" "$OUT"
+check_not "N=1은 배정 대기 출력이 없다" "배정 완료" "$OUT"
+check_not "N=1은 shard 추가 인자가 없다" "instance-id" "$(cat "$FAKE/java.calls")"
+equals "N=1 java 호출 1번" "1" "$(grep -c '^java' "$FAKE/java.calls")"
+W1="$FAKE/work-1"
+equals "N=1 java 인자가 기존 명령과 같다" "java --add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED -Xlog:gc*:file=$W1/logs/gc-matching.log:time,uptime -jar /x/m.jar --spring.config.additional-location=file:$W1/m0.yml --spring.kafka.bootstrap-servers=localhost:19092" "$(head -1 "$FAKE/java.calls")"
+rm -rf "$FAKE" "$U10LOG"
+
+echo "PASS=$PASS FAIL=$FAIL"
+[ "$FAIL" = 0 ]
